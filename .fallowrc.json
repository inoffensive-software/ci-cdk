{
  "$schema": "./node_modules/fallow/schema.json",
  // Vendored oxlint plugin: owned by its upstream, not part of our architecture.
  "ignorePatterns": ["tools/**"],
  "duplicates": {
    // Hide pair-only clones; report only widespread copy-paste worth refactoring.
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "error",
    "boundary-violation": "error"
  },
  "boundaries": {
    // One zone per source directory. Core may import nothing from the project; a provider may
    // import core and nothing else. Providers are mutually isolated without pairwise rules.
    "zones": [
      { "name": "core", "patterns": ["src/core/**"] },
      { "name": "github-actions", "patterns": ["src/github-actions/**"] }
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "github-actions", "allow": ["core"] }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": ["src/index.ts", "vitest.config.ts", "test/**", "**/*.test.ts"]
    }
  }
}
