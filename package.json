{
  "name": "@inoffensive/ci-cdk",
  "version": "0.0.0",
  "description": "Typed TypeScript DSL that compiles to CI provider configuration.",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bitbucket-pipelines": {
      "types": "./dist/bitbucket-pipelines/index.d.ts",
      "default": "./dist/bitbucket-pipelines/index.js"
    },
    "./github-actions": {
      "types": "./dist/github-actions/index.d.ts",
      "default": "./dist/github-actions/index.js"
    },
    "./gitlab-ci": {
      "types": "./dist/gitlab-ci/index.d.ts",
      "default": "./dist/gitlab-ci/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "compile": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --no-ignore",
    "fallow": "fallow",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm fmt:check && pnpm compile && pnpm typecheck && pnpm lint && pnpm test && pnpm fallow",
    "ci": "bash tools/ci/ci.sh",
    "ci:workflow": "pnpm compile && node tools/ci/workflow.mts > .github/workflows/ci.yml"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "@types/node": "^26.6.5",
    "ajv": "8.20.0",
    "fallow": "^3.37.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
